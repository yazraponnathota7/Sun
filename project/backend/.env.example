# Use the SESSION POOLER string from Supabase > Connect (host like aws-0-xx.pooler.supabase.com, port 5432).
# The direct db.<ref>.supabase.co host is IPv6-only and fails on Render/Railway.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=replace_me
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional (defaults to SUPABASE_URL/auth/v1)
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# Only for older projects that still use the legacy HS256 JWT secret. Leave empty for new projects.
SUPABASE_JWT_SECRET=
# Comma-separated list of allowed frontend origins (no trailing slash needed)
APP_CORS_ORIGINS=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
# Optional: enables Pay online (Razorpay). Use TEST keys (rzp_test_...) first. Leave empty for pay-at-counter only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Configure this same secret in Razorpay Dashboard > Webhooks. Never expose it to the frontend.
RAZORPAY_WEBHOOK_SECRET=
